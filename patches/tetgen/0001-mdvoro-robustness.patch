From: tj-barrett <barrett.t@northeastern.edu>
Date: Wed, 21 Oct 2026 20:28:06 -0400
Subject: [PATCH] Robustness fixes for meshing Voronoi PLCs from MD microstructures

Against TetGen 1.6.1, https://github.com/TetGen/TetGen (mirror of
codeberg.org/TetGen/TetGen) commit 5203ac3540d5092163c1bce61737f75a21703e1b
(2026-10-08). The upstream test suite (328 tests) passes with the patch.

Large mdvoro PLCs (non-planar facets, many short edges, 50-60 sigma RVEs)
crashed or corrupted memory in -pA and -pYA runs:

1. sscoutsegment(): NULL neighbours at 3 sites, and a bound on the walk
   step (non-planar facets could walk forever).
2. sinsertvertex(): drop boundary edges whose outer face joined the
   cavity sC(p). They left a dangling bond and corrupted the memory pool.
3. flip32(): a 3-to-2 flip of an edge in a facet flips its two subfaces;
   undoing it with flip23() (flipnm_post with nn == 2, and the flip-back in
   remove_ndelaunay_edge()) recreated the edge but not the subfaces, which
   was the -pA improve_mesh segfault. New tetgenmesh::unflip22() flips them
   back and copies the region attributes into the restored tet; flipnm()
   records the excluded link vertex in abtets[2]. A terminatetetgen(2)
   guard on subface counts 1 or 3 is kept as a fallback.
4. check_segments() (-C): NULL dereference.

---
diff --git a/tetgen.cxx b/tetgen.cxx
index fc61dac..4f02e92 100644
--- a/tetgen.cxx
+++ b/tetgen.cxx
@@ -7598,6 +7598,115 @@ void tetgenmesh::flip23(triface* fliptets, int hullflag, flipconstraints *fc)
   recenttet = fliptets[0];
 }
 
+//============================================================================//
+//                                                                            //
+// unflip22()    Undo the 2-to-2 flip of subfaces done by a 3-to-2 flip.      //
+//                                                                            //
+// flip32() of an edge [e,d] which is in a facet also flips its two subfaces  //
+// [e,d,p] and [e,d,q] into [p,q,e] and [p,q,d].  A flip23() which undoes     //
+// this 3-to-2 flip recreates the edge [e,d] but not the subfaces, i.e., it   //
+// leaves them at [p,q].  This routine flips them back to [e,d].              //
+//                                                                            //
+// 'fliptets' are the three tets [e,d,*,*] returned by flip23(). 'r' is the   //
+// link vertex of [e,d] which is not in the two subfaces.                     //
+//                                                                            //
+//============================================================================//
+
+void tetgenmesh::unflip22(triface* fliptets, point r, flipconstraints *fc)
+{
+  triface topface, botface, spintet, neightet;
+  face flipfaces[2], checksh;
+  point pe, pd, px, py, pv;
+  int t1ver;
+  int i, j, k;
+
+  // Find the tet [e,d,p,q], its faces [d,p,q] and [e,p,q] are subfaces.
+  for (i = 0; i < 3; i++) {
+    px = apex(fliptets[i]);
+    py = oppo(fliptets[i]);
+    if ((px == r) || (py == r)) continue;
+    eorgoppo(fliptets[i], topface); // [d,p,q], opposite to e.
+    edestoppo(fliptets[i], botface); // [e,p,q], opposite to d.
+    if (issubface(topface) && issubface(botface)) break;
+  }
+  if (i == 3) {
+    // The subfaces are not found. Report a bug.
+    terminatetetgen(this, 2);
+  }
+  pe = org(fliptets[i]);
+  pd = dest(fliptets[i]);
+  tspivot(topface, flipfaces[0]);
+  tspivot(botface, flipfaces[1]);
+
+  // Detach the two subfaces from the tets at both of their sides.
+  for (j = 0; j < 2; j++) {
+    stdissolve(flipfaces[j]);
+  }
+  tsdissolve(topface);
+  fsym(topface, neightet);
+  tsdissolve(neightet);
+  tsdissolve(botface);
+  fsym(botface, neightet);
+  tsdissolve(neightet);
+
+  // Flip [p,q,d] and [q,p,e] into [d,e,q] and [e,d,p].
+  for (k = 0; k < 3; k++) {
+    if (sapex(flipfaces[0]) == pd) break;
+    senextself(flipfaces[0]);
+  }
+  for (k = 0; k < 3; k++) {
+    if (sapex(flipfaces[1]) == pe) break;
+    senextself(flipfaces[1]);
+  }
+  if ((sapex(flipfaces[0]) != pd) || (sapex(flipfaces[1]) != pe)) {
+    terminatetetgen(this, 2);
+  }
+  flip22(flipfaces, 0, fc->chkencflag);
+
+  // Bond the two new subfaces to the tets at the faces [e,d,p], [e,d,q].
+  for (j = 0; j < 2; j++) {
+    for (k = 0; k < 3; k++) {
+      if ((sapex(flipfaces[j]) != pe) && (sapex(flipfaces[j]) != pd)) break;
+      senextself(flipfaces[j]);
+    }
+    pv = sapex(flipfaces[j]);
+    if (sorg(flipfaces[j]) != pe) {
+      sesymself(flipfaces[j]); // [e,d,v]
+    }
+    spintet = fliptets[i]; // [e,d,p,q]
+    for (k = 0; k < 3; k++) {
+      if (apex(spintet) == pv) break;
+      fnextself(spintet);
+    }
+    if ((apex(spintet) != pv) || (sorg(flipfaces[j]) != pe) ||
+        (sdest(flipfaces[j]) != pd)) {
+      terminatetetgen(this, 2);
+    }
+    tspivot(spintet, checksh);
+    if (checksh.sh != NULL) {
+      // There is already a subface. Report a bug.
+      terminatetetgen(this, 2);
+    }
+    tsbond(spintet, flipfaces[j]);
+    fsymself(spintet);
+    sesymself(flipfaces[j]);
+    tsbond(spintet, flipfaces[j]);
+  }
+
+  // flip23() gave the three tets the attributes of one old tet. The subfaces
+  //   separate [e,d,p,q] from the other two: it is in the region across its
+  //   faces [d,p,q] and [e,p,q], which are no longer subfaces.
+  fsym(topface, neightet);
+  if (!ishulltet(neightet)) {
+    for (j = 0; j < numelemattrib; j++) {
+      setelemattribute(fliptets[i].tet, j, elemattribute(neightet.tet, j));
+    }
+    if (b->varvolume) {
+      setvolumebound(fliptets[i].tet, volumebound(neightet.tet));
+    }
+  }
+}
