+
 
   // Creating new subfaces.
   for (i = 0; i < caveshbdlist->objects; i++) {
@@ -13754,9 +13907,22 @@ enum tetgenmesh::interresult tetgenmesh::sscoutsegment(face *searchsh,
   }
   len = distance(startpt, endpt);
 
+  // Every step keeps 'startpt' as origin, so a walk can not visit more
